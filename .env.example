# Copy to .env.local. These fake values are enough to build, run and test locally.
# Real values live only in the deploy platform's environment settings. Never commit them.

# Supabase project URL and public anon key
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=fake-anon-key
# Server-only Supabase key (bypasses row-level security; never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=fake-service-role-key

# Flutterwave keys (use test keys locally)
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-fake-X
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-fake-X

# Brevo transactional email API key
BREVO_API_KEY=fake-brevo-key

# Public URL of this app, used in email links
NEXT_PUBLIC_APP_URL=http://localhost:3002
